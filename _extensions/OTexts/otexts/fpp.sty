% Title page
\def\titlepage{%
  \cleardoublepage%
  {%
    \sffamily%
    \otextsraggedright
      \fontsize{14}{18}\selectfont\par\noindent\textcolor{darkgray}{{%
          \otextsbookauthors%
      }}%
      \par\vspace{9.5pc}%
      \fontsize{36}{48}\selectfont\par\noindent\textcolor{darkgray}{{\otextstitle}}%
      \vfill%
      %\fontsize{14}{16}\selectfont\par\noindent{\thanklesspublisher}%
      \par\noindent\otextslogo\par
  }
  \thispagestyle{empty}%
  \clearpage%
  % copyright page
  \newpage
    ~\vfill
    \thispagestyle{empty}
    \setlength{\parindent}{0pt}
    \setlength{\parskip}{\baselineskip}
