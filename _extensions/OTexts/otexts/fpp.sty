% Page breaks in long code blocks (see code-blocks.lua): between
% \otextscodebreaks{3,9} and \otextscodebreaksoff, a page may break after lines
% 3 and 9 and nowhere else. The k-th penalty fancyvrb puts between lines is the
% one after line k.
\RequirePackage{etoolbox}
\newcount\otexts@line
\let\otexts@breaks\relax
\newcommand{\otextscodebreaks}[1]{\gdef\otexts@breaks{#1}\global\otexts@line\z@}
\newcommand{\otextscodebreaksoff}{\global\let\otexts@breaks\relax}
\def\otexts@penalty{%
  \ifx\otexts@breaks\relax\else
    \global\advance\otexts@line\@ne
    \edef\otexts@tmp{\noexpand\in@{,\the\otexts@line,}{,\otexts@breaks,}}\otexts@tmp
    \ifin@\interlinepenalty\z@\else\interlinepenalty\@M\fi
  \fi}
\ifcsname FV@ListProcessLine@iv\endcsname
  \def\otexts@patchfailed{\PackageWarning{fpp}{Can't patch fancyvrb: long code blocks may break anywhere}}
  \patchcmd{\FV@ListProcessLine@iii}{\clubpenalty\penalty}{\clubpenalty\otexts@penalty\penalty}{}{\otexts@patchfailed}
  \patchcmd{\FV@ListProcessLine@iv}{\penalty\interlinepenalty}{{\otexts@penalty\penalty\interlinepenalty}}{}{\otexts@patchfailed}
  \patchcmd{\FV@ListProcessLastLine}{\widowpenalty\penalty}{\widowpenalty\otexts@penalty\penalty}{}{\otexts@patchfailed}
\fi

