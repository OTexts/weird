% Strings a book can redefine in header-includes
\providecommand{\otextschapter}{Chapter}
\providecommand{\otextsraggedright}{\raggedright}
% Logo on the title page, at the start of the line for the book's direction
\providecommand{\otextslogo}{\includegraphics[width=5cm]{extrafiles/OTexts-graylogo}}
% The title, subtitle, authors and ISBN (\otextsbooktitle, \otextsbooksubtitle,
% \otextsbookauthors, \otextsisbn, \otextssiteurl, \otextsprintedition) and the running head (\otextsrunningtitle,
% the title unless `runningtitle` is set) come from the book's YAML, through
% before-title.tex
\providecommand{\otextstitle}{\otextsbooktitle
  \ifdefempty{\otextsbooksubtitle}{}{\par{\large\otextsbooksubtitle}}}
\providecommand{\otextscopyrightpage}{%
    \emph{\otextsbooktitle}\par
    \ifdefempty{\otextsisbn}{}{ISBN \otextsisbn\par}
    Copyright \textcopyright\ \the\year. OTexts
    \par{Available online at \textit{\otextssiteurl}}
    \ifdefempty{\otextsprintedition}{}{\par\textit{\otextsprintedition, \monthyear}}
    \par\textsc{Published by OTexts}
}

